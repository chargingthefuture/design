{
  "version": "1.0",
  "last_updated": "2026-05-31",
  "description": "Defines exactly which files flow from the design repo to the app repo. Both agents read this before any sync. Nothing outside this manifest is touched during a sync.",
  "sync_direction": "design-repo → app-repo (one-way only)",
  "header_marker": "// design-sync",
  "rules": [
    "COPY only — never delete any file in the app repo",
    "ONLY touch files listed under components.files — ignore everything else",
    "OVERWRITE silently if the file exists in the app repo and carries the header_marker",
    "SKIP any app-repo file that does not carry the header_marker — it is app-owned",
    "NEVER modify files outside components.dest_dir in the app repo",
    "NEVER write back from the app repo to the design repo",
    "ADD the header_marker comment as the first line of every synced file"
  ],
